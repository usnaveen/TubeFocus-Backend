{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tubefocus.dev/schemas/relevance_label.json",
  "title": "TubeFocusRelevanceLabel",
  "type": "object",
  "required": ["goal", "title", "label"],
  "properties": {
    "id": { "type": "string", "description": "Stable example id" },
    "goal": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "default": "" },
    "label": {
      "description": "Binary relevance (SetFit) or graded score",
      "oneOf": [
        { "type": "integer", "enum": [0, 1] },
        { "type": "integer", "minimum": 0, "maximum": 100 }
      ]
    },
    "source": {
      "type": "string",
      "enum": ["human", "gemini_distill", "heuristic", "synthetic"],
      "default": "human"
    },
    "video_id": { "type": "string" },
    "split": {
      "type": "string",
      "enum": ["train", "val", "test"],
      "default": "train"
    }
  },
  "additionalProperties": false
}
